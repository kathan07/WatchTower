# Copy this file. Do not put real secrets in git.
# See LOCAL_SETUP.md for where each copy must live.

NODE_ENV=development

# PostgreSQL. Prisma reads this. Create the database before migrate.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/watchtower_dev

# Redis. Default in code is redis://localhost:6379 if unset.
REDIS_URL=redis://localhost:6379

# API (apps/server). PORT defaults to 3000 if unset.
PORT=3000
JWT_SECRET=replace-with-a-long-random-string

# Stripe secret key and webhook signing secret (server only).
# Checkout in the client uses a publishable key hardcoded in apps/client/src/pages/Plans.tsx.
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Vite dev proxy (apps/client only). Must be the API origin, no trailing path.
SERVER_URL_LOCAL=http://localhost:3000

# Alert emails (apps/alerting-service). Leave blank if you are not testing mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WatchTower <alerts@localhost>
